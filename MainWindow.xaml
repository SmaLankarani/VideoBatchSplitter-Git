<Window x:Class="VideoBatchSplitter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Batch Splitter"
        Icon="/Assets/logo.ico"
        Width="800"
        Height="720"
        MinWidth="720"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,22">

            <TextBlock Text="Video Batch Splitter"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#17202A"/>

            <TextBlock Text="Randomly or sequentially divide videos into separate folders"
                       Margin="0,6,0,0"
                       FontSize="14"
                       Foreground="#68737D"/>

        </StackPanel>


        <!-- SOURCE -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,14">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Source folder"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,18,0"/>

                <TextBox x:Name="SourceFolderTextBox"
                         Grid.Column="1"
                         Height="38"
                         VerticalContentAlignment="Center"
                         Padding="10"
                         BorderBrush="#D7DDE2"
                         TextChanged="SourceFolderTextBox_TextChanged"/>

                <Button x:Name="BrowseButton"
                        Grid.Column="2"
                        Content="Browse..."
                        Width="92"
                        Height="38"
                        Margin="12,0,0,0"
                        Click="BrowseSource_Click"/>

            </Grid>

        </Border>


        <!-- OPTIONS -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,14">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Videos per folder"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Number of videos placed in each folder"
                               FontSize="12"
                               Foreground="#7A858F"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <TextBox x:Name="BatchSizeTextBox"
                         Grid.Column="1"
                         Text="100"
                         Width="90"
                         Height="38"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         Padding="8"
                         Margin="16,0,30,0"
                         TextChanged="BatchSizeTextBox_TextChanged"/>


                <StackPanel Grid.Column="2"
                            Margin="0,0,30,0">

                    <TextBlock Text="Operation"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal">

                        <RadioButton x:Name="MoveRadioButton"
                                     Content="Move"
                                     IsChecked="True"
                                     Margin="0,0,18,0"/>

                        <RadioButton x:Name="CopyRadioButton"
                                     Content="Copy"/>

                    </StackPanel>

                </StackPanel>


                <StackPanel Grid.Column="3">

                    <TextBlock Text="Order"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <StackPanel>

                        <RadioButton x:Name="RandomRadioButton"
                                     Content="Random"
                                     IsChecked="True"
                                     Margin="0,0,0,7"/>

                        <RadioButton x:Name="OriginalRadioButton"
                                     Content="Original"/>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>


        <!-- INFORMATION -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,14">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel>

                    <TextBlock Text="Videos found"
                               Foreground="#7A858F"/>

                    <TextBlock x:Name="FoundText"
                               Text="0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"/>

                </StackPanel>


                <StackPanel Grid.Column="1">

                    <TextBlock Text="Folders to create"
                               Foreground="#7A858F"/>

                    <TextBlock x:Name="FoldersText"
                               Text="0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"/>

                </StackPanel>


                <StackPanel Grid.Column="2">

                    <TextBlock Text="Status"
                               Foreground="#7A858F"/>

                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,7,0,0"/>

                </StackPanel>


                <Button x:Name="PerformanceCheckButton"
                        Grid.Column="3"
                        Content="Performance Check"
                        Width="145"
                        Height="38"
                        Margin="18,0,0,0"
                        Click="PerformanceCheck_Click"/>

            </Grid>

        </Border>


        <!-- PROGRESS -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="12"
                Padding="18">

            <StackPanel>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Progress"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="ProgressPercentText"
                               Grid.Column="1"
                               Text="0%"
                               FontWeight="SemiBold"/>

                </Grid>


                <ProgressBar x:Name="ProgressBar"
                             Height="14"
                             Margin="0,12,0,12"
                             Minimum="0"
                             Maximum="100"/>


                <TextBlock x:Name="CurrentFileText"
                           Text="Choose a source folder to begin."
                           Foreground="#68737D"
                           TextWrapping="Wrap"/>


                <Grid Margin="0,18,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel>

                        <TextBlock Text="Transferred"
                                   FontSize="12"
                                   Foreground="#7A858F"/>

                        <TextBlock x:Name="TransferredText"
                                   Text="0 MB / 0 MB"
                                   FontWeight="SemiBold"
                                   Margin="0,3,0,0"/>

                    </StackPanel>


                    <StackPanel Grid.Column="1">

                        <TextBlock Text="Speed"
                                   FontSize="12"
                                   Foreground="#7A858F"/>

                        <TextBlock x:Name="SpeedText"
                                   Text="0 MB/s"
                                   FontWeight="SemiBold"
                                   Margin="0,3,0,0"/>

                    </StackPanel>


                    <StackPanel Grid.Column="2">

                        <TextBlock Text="ETA"
                                   FontSize="12"
                                   Foreground="#7A858F"/>

                        <TextBlock x:Name="EtaText"
                                   Text="--:--"
                                   FontWeight="SemiBold"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>


                <Grid Margin="0,18,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Current file"
                               FontSize="12"
                               Foreground="#7A858F"/>

                    <TextBlock x:Name="CurrentFileProgressText"
                               Grid.Column="1"
                               Text="0%"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                </Grid>


                <ProgressBar x:Name="CurrentFileProgressBar"
                             Height="8"
                             Margin="0,8,0,0"
                             Minimum="0"
                             Maximum="100"/>

            </StackPanel>

        </Border>


        <!-- BUTTONS -->
        <Grid Grid.Row="5"
      Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <Button x:Name="StartButton"
            Grid.Column="0"
            Content="START"
            Height="50"
            FontSize="15"
            FontWeight="Bold"
            Background="#1F6FEB"
            Foreground="White"
            BorderThickness="0"
            Click="Start_Click"/>


            <Button x:Name="CancelButton"
            Grid.Column="1"
            Content="CANCEL"
            Width="110"
            Height="50"
            Margin="12,0,0,0"
            FontSize="14"
            FontWeight="SemiBold"
            IsEnabled="False"
            Click="Cancel_Click"/>

        </Grid>


        <!-- VERSION -->
        <TextBlock x:Name="VersionText"
           Grid.Row="6"
           Text="Version 1.0.0"
           FontSize="11"
           Foreground="#8A949E"
           HorizontalAlignment="Right"
           Margin="0,8,2,0"/>

    </Grid>

</Window>